# Local application runtime. Relative paths resolve from the repository root.
APP_ENV=development
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
UPLOADS_DIR=./uploads
EXPORTS_DIR=./exports
DATABASE_PATH=./data/generathon.sqlite3

# Managed providers. Keep real values in .env only.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Future open-weight worker deployment.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
HF_TOKEN=
