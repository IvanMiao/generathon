{
  "name": "generathon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:web && npm run lint:python",
    "lint:web": "eslint src next.config.ts vitest.config.ts",
    "lint:python": "uv run ruff check scripts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:web && npm run test:python",
    "test:web": "vitest run",
    "test:python": "uv run python -m py_compile scripts/step0_mir_smoke.py scripts/step0_provider_smoke.py",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
